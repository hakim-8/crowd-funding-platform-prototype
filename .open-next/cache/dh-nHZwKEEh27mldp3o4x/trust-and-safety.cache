escription\" content=\"Pioneering the future of crowdfunding. Empowering issuers and investors.\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.2vob68tjqpejf.ico\" sizes=\"256x256\" type=\"image/x-icon\"/><script src=\"https://cdn.tailwindcss.com\"></script><style type=\"text/tailwindcss\">\n              @layer utilities {\n                .glass {\n                  background: rgba(253, 251, 247, 0.7);\n                  backdrop-filter: blur(10px);\n                  -webkit-backdrop-filter: blur(10px);\n                  border: 1px solid rgba(255, 255, 255, 0.3);\n                }\n              }\n            </style><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-full flex flex-col selection:bg-[#059669] selection:text-[#fdfbf7] relative\"><div hidden=\"\"><!--$--><!--/$--></div><div class=\"fixed inset-0 bg-[#fdfbf7] -z-20\"></div><div class=\"fixed inset-0 bg-dot-pattern pointer-events-none -z-18\"></div><div class=\"fixed top-[-10%] right-[-10%] w-[50vw] h-[50vw] max-w-[600px] rounded-full bg-[#ecfdf5] opacity-80 blur-3xl pointer-events-none -z-15\"></div><div class=\"fixed bottom-[-10%] left-[-10%] w-[60vw] h-[60vw] max-w-[700px] rounded-full bg-[#059669]/5 blur-3xl pointer-events-none -z-15\"></div><canvas class=\"fixed inset-0 pointer-events-none -z-10\" style=\"opacity:0.8\"></canvas><style>\n        @media (min-width: 768px) {\n          .nav-desktop-only { display: flex !important; }\n          .nav-mobile-only { display: none !important; }\n          .nav-desktop-space-x > :not([hidden]) ~ :not([hidden]) {\n            --tw-space-x-reverse: 0;\n            margin-right: calc(2rem * var(--tw-space-x-reverse));\n            margin-left: calc(2rem * calc(1 - var(--tw-space-x-reverse)));\n          }\n        }\n        @media (max-width: 767px) {\n          .nav-desktop-only { display: none !important; }\n          .nav-mobile-only { display: flex !important; }\n        }\n      </style><nav class=\"sticky top-0 z-40 w-full glass shadow-sm\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"flex justify-between h-20 items-center\"><div class=\"flex-shrink-0 flex items-center\"><a class=\"text-2xl font-bold tracking-tighter text-[#064e3b] flex items-center gap-2\" href=\"/\"><svg class=\"w-8 h-8 filter drop-shadow-[0_2px_8px_rgba(16,185,129,0.35)] hover:rotate-12 transition-transform duration-300\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M9 9H15L17 2H7L9 9Z\" fill=\"#a7f3d0\"></path><path d=\"M7 2L9 9H2L7 2Z\" fill=\"#34d399\"></path><path d=\"M17 2L15 9H22L17 2Z\" fill=\"#059669\"></path><path d=\"M9 9H15L12 22L9 9Z\" fill=\"#10b981\"></path><path d=\"M2 9H9L12 22L2 9Z\" fill=\"#065f46\"></path><path d=\"M15 9H22L12 22L15 9Z\" fill=\"#047857\"></path></svg>Jade Fortune</a></div><div class=\"nav-mobile-only items-center\"><button class=\"text-[#064e3b] hover:text-[#059669] focus:outline-none focus:ring-2 focus:ring-inset focus:ring-[#059669] rounded-md p-2\"><span class=\"sr-only\">Open main menu</span><svg class=\"h-6 w-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6h16M4 12h16M4 18h16\"></path></svg></button></div><div class=\"nav-desktop-only nav-desktop-space-x items-center w-full justify-end hidden\"><a class=\"text-[#064e3b] font-medium transition-colors hover:opacity-80 whitespace-nowrap\" href=\"/\">Home</a><a style=\"color:#064e3b\" class=\"font-medium transition-colors hover:opacity-80 whitespace-nowrap\" href=\"/how-it-works\">How It Works</a><div class=\"relative\"><button style=\"color:#064e3b\" class=\"flex items-center font-medium transition-colors hover:opacity-80 gap-1 whitespace-nowrap\">More<svg class=\"w-4 h-4 transition-transform \" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"></path></svg></button></div><div class=\"relative\"><button style=\"color:#064e3b\" class=\"flex items-center font-medium transition-colors hover:opacity-80 gap-1 whitespace-nowrap\">Issuer<svg class=\"w-4 h-4 transition-transform \" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"></path></svg></button></div><div class=\"relative\"><button class=\"flex items-center font-medium transition-colors hover:opacity-80 gap-1 whitespace-nowrap\">Investors<svg class=\"w-4 h-4 transition-transform \" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"></path></svg></button></div></div></div></div></nav><main class=\"flex-grow relative z-10\"><div class=\"flex flex-col min-h-screen bg-[#fdfbf7] pb-24\"><section class=\"pt-32 pb-24 px-4 text-center bg-[#064e3b] relative overflow-hidden\"><div class=\"absolute inset-0 bg-dot-pattern opacity-30 mix-blend-overlay\"></div><div class=\"absolute top-0 right-0 w-96 h-96 bg-[#059669] rounded-full filter blur-3xl opacity-40 transform translate-x-1/2 -translate-y-1/2\"></div><div class=\"relative z-10 max-w-4xl mx-auto\"><div class=\"inline-block mb-4 px-4 py-1.5 rounded-full bg-white/10 border border-white/20 backdrop-blur-sm\"><span class=\"text-sm font-semibold tracking-wide text-white uppercase\">Security First</span></div><h1 class=\"text-5xl md:text-6xl font-extrabold text-white tracking-tight mb-6\">Trust is Our Foundation</h1><p class=\"text-xl text-white/80 max-w-2xl mx-auto leading-relaxed\">At Jade Fortune, we don&#x27;t just facilitate funding; we engineer trust. Explore the rigorous systems we use to protect our community.</p></div></section><section class=\"max-w-7xl mx-auto px-4 w-full -mt-12 relative z-20\"><div class=\"grid grid-cols-1 lg:grid-cols-3 gap-8\"><div class=\"lg:col-span-2 space-y-8\"><div class=\"bg-white p-8 md:p-10 rounded-3xl shadow-lg border border-[#f2eadb]\"><div class=\"w-16 h-16 bg-[#ecfdf5] rounded-2xl flex items-center justify-center text-3xl mb-6 shadow-inner\">📋</div><h2 class=\"text-2xl font-bold text-[#064e3b] mb-4\">The Vetting Protocol</h2><p class=\"text-[#064e3b]/80 mb-6 leading-relaxed\">Every project on Jade Fortune is subject to an uncompromising review before it ever reaches our backers. We believe that preventative care is the best defense against fraud.</p><ul class=\"space-y-4\"><li class=\"flex items-start gap-3 text-[#064e3b]/80\"><div class=\"w-6 h-6 rounded-full bg-[#059669]/10 text-[#059669] flex items-center justify-center font-bold text-sm shrink-0 mt-0.5\">1</div><span><strong>Identity Verification (KYC):</strong> All creators must pass strict government ID and biometric verification.</span></li><li class=\"flex items-start gap-3 text-[#064e3b]/80\"><div class=\"w-6 h-6 rounded-full bg-[#059669]/10 text-[#059669] flex items-center justify-center font-bold text-sm shrink-0 mt-0.5\">2</div><span><strong>Business Entity Checks:</strong> We verify corporate registration, tax status, and ultimate beneficial owners (UBOs).</span></li><li class=\"flex items-start gap-3 text-[#064e3b]/80\"><div class=\"w-6 h-6 rounded-full bg-[#059669]/10 text-[#059669] flex items-center justify-center font-bold text-sm shrink-0 mt-0.5\">3</div><span><strong>Independent Financial Audit:</strong> Third-party CPAs review financial projections and current asset health.</span></li><li class=\"flex items-start gap-3 text-[#064e3b]/80\"><div class=\"w-6 h-6 rounded-full bg-[#059669]/10 text-[#059669] flex items-center justify-center font-bold text-sm shrink-0 mt-0.5\">4</div><span><strong>Feasibility Analysis:</strong> Industry experts evaluate the technical and market feasibility of the proposed product.</span></li></ul></div><div class=\"bg-white p-8 md:p-10 rounded-3xl shadow-lg border border-[#f2eadb]\"><div class=\"w-16 h-16 bg-[#ecfdf5] rounded-2xl flex items-center justify-center text-3xl mb-6 shadow-inner\">🔐</div><h2 class=\"text-2xl font-bold text-[#064e3b] mb-4\">Fraud Prevention &amp; Escrow</h2><p class=\"text-[#064e3b]/80 mb-6 leading-relaxed\">Once a project is live, our technological infrastructure takes over to protect funds. We do not disburse capital blindly.</p><div class=\"bg-[#fdfbf7] p-6 rounded-2xl border border-[#059669]/20 mb-6\"><h3 class=\"font-bold text-[#059669] mb-2 flex items-center gap-2\"><svg class=\"w-5 h-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z\"></path></svg>Milestone-Based Smart Contracts</h3><p class=\"text-[#064e3b]/70 text-sm\">Funds are held in secure escrow. They are only released in predefined tranches as the creator achieves verifiable milestones. If a project stalls, remaining funds are protected.</p></div><p class=\"text-[#064e3b]/80 leading-relaxed\">Additionally, our ML-driven anomaly detection monitors all transactions for suspicious patterns, money laundering attempts, and coordinate bot activity, neutralizing threats in real-time.</p></div><div class=\"bg-white p-8 md:p-10 rounded-3xl shadow-lg border border-[#f2eadb]\"><h2 class=\"text-2xl font-bold text-[#064e3b] mb-4\">Dispute Resolution</h2><p class=\"text-[#064e3b]/80 mb-4 leading-relaxed\">While our vetting prevents most issues, disagreements can occur. We offer a structured arbitration process.</p><ul class=\"list-disc pl-5 space-y-2 text-[#064e3b]/80\"><li>Direct mediation channel opened between creator and backers.</li><li>Platform intervention if the creator fails to respond within 14 days.</li><li>Vote by backers to pause further escrow disbursement if milestones are contested.</li></ul></div></div><div class=\"space-y-8\"><div class=\"bg-[#064e3b] text-white p-8 rounded-3xl shadow-xl shadow-[#064e3b]/20\"><h3 class=\"text-xl font-bold mb-6\">Verification Badges</h3><div class=\"space-y-6\"><div class=\"flex gap-4\"><div class=\"shrink-0 pt-1\"><svg class=\"w-8 h-8 text-[#34d399]\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z\"></path></svg></div><div><h4 class=\"font-bold text-[#a7f3d0]\">Identity Verified</h4><p class=\"text-sm text-white/70\">The creator has passed stringent KYC checks.</p></div></div><div class=\"flex gap-4\"><div class=\"shrink-0 pt-1\"><svg class=\"w-8 h-8 text-blue-400\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z\"></path></svg></div><div><h4 class=\"font-bold text-blue-200\">Fully Audited</h4><p class=\"text-sm text-white/70\">Project financials and plans have been verified by third-party CPAs.</p></div></div><div class=\"flex gap-4\"><div class=\"shrink-0 pt-1\"><svg class=\"w-8 h-8 text-yellow-400\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z\"></path></svg></div><div><h4 class=\"font-bold text-yellow-200\">Track Record</h4><p class=\"text-sm text-white/70\">Creator has successfully delivered 3+ projects on Jade Fortune.</p></div></div></div></div><div class=\"bg-[#ecfdf5] border border-[#34d399]/30 p-8 rounded-3xl text-center\"><div class=\"w-12 h-12 bg-white rounded-full flex items-center justify-center mx-auto mb-4 text-[#059669]\"><svg class=\"w-6 h-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"></path></svg></div><h3 class=\"font-bold text-[#064e3b] mb-2\">Understand the Risks</h3><p class=\"text-[#064e3b]/70 text-sm mb-6\">All early-stage investments carry risk. We strongly advise reading our full risk disclosure before pledging.</p><a class=\"inline-block w-full py-3 bg-white border border-[#059669]/20 text-[#059669] font-bold rounded-xl hover:bg-gray-50 transition-colors\" href=\"/risk-disclosure\">Read Risk Disclosure</a></div><div class=\"bg-white border border-[#f2eadb] p-8 rounded-3xl text-center shadow-sm\"><h3 class=\"font-bold text-[#064e3b] mb-2\">See something suspicious?</h3><p class=\"text-[#064e3b]/70 text-sm mb-4\">Our community is our best defense.</p><a class=\"text-red-500 font-bold hover:underline\" href=\"/contact\">Report a project</a></div></div></div></section></div><!--$--><!--/$--></main><footer class=\"bg-diamond-grid-green text-[#fdfbf7]/80 py-12 mt-auto border-t border-[#10b981]/20 relative overflow-hidden\"><div class=\"absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-[#10b981] to-[#064e3b]\"></div><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\"><div style=\"display:grid;grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));gap:3rem\"><div style=\"grid-column:1 / -1;max-width:400px\" class=\"mb-4\"><a class=\"text-2xl font-bold tracking-tighter text-[#fdfbf7] flex items-center gap-2 mb-4\" href=\"/\"><svg class=\"w-8 h-8 filter drop-shadow-[0_2px_8px_rgba(16,185,129,0.45)] hover:rotate-12 transition-transform duration-300\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M9 9H15L17 2H7L9 9Z\" fill=\"#a7f3d0\"></path><path d=\"M7 2L9 9H2L7 2Z\" fill=\"#34d399\"></path><path d=\"M17 2L15 9H22L17 2Z\" fill=\"#059669\"></path><path d=\"M9 9H15L12 22L9 9Z\" fill=\"#10b981\"></path><path d=\"M2 9H9L12 22L2 9Z\" fill=\"#065f46\"></path><path d=\"M15 9H22L12 22L15 9Z\" fill=\"#047857\"></path></svg>Jade Fortune</a><p class=\"text-sm leading-relaxed mb-6\">Pioneering the future of crowdfunding. We connect visionary projects with issuers and investors globally, ensuring transparency and success.</p></div><div><h3 class=\"text-[#fdfbf7] font-semibold mb-4 tracking-wide uppercase text-sm\">Platform</h3><ul class=\"space-y-3 text-sm\"><li><a class=\"hover:text-[#10b981] transition-colors\" href=\"/\">Home</a></li><li><a class=\"hover:text-[#10b981] transition-colors\" href=\"/about\">About Us</a></li><li><a class=\"hover:text-[#10b981] transition-colors\" href=\"/how-it-works\">How It Works</a></li><li><a class=\"hover:text-[#10b981] transition-colors\" href=\"/pricing\">Pricing &amp; Fees</a></li><li><a class=\"hover:text-[#10b981] transition-colors\" href=\"/projects\">Discover Projects</a></li><li><a class=\"hover:text-[#10b981] transition-colors\" href=\"/faq\">FAQ</a></li><li><a class=\"hover:text-[#10b981] transition-colors\" href=\"/trust-and-safety\">Trust &amp; Safety</a></li><li><a class=\"hover:text-[#10b981] transition-colors\" href=\"/contact\">Contact</a></li></ul></div><div><h3 class=\"text-[#fdfbf7] font-semibold mb-4 tracking-wide uppercase text-sm\">Legal</h3><ul class=\"space-y-3 text-sm\"><li><a href=\"#\" class=\"hover:text-[#10b981] transition-colors\">Terms of Service</a></li><li><a href=\"#\" class=\"hover:text-[#10b981] transition-colors\">Privacy Policy</a></li><li><a href=\"#\" class=\"hover:text-[#10b981] transition-colors\">Cookie Policy</a></li><li><a href=\"#\" class=\"hover:text-[#10b981] transition-colors\">Risk Disclosure</a></li></ul></div><div><h3 class=\"text-[#fdfbf7] font-semibold mb-4 tracking-wide uppercase text-sm\">Follow Us</h3><div class=\"flex gap-4\"><a href=\"#\" class=\"w-10 h-10 rounded-full bg-[#10b981]/10 flex items-center justify-center hover:bg-[#10b981]/20 transition-all\"><span class=\"sr-only\">Twitter</span><svg class=\"w-5 h-5 text-[#10b981]\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M24 4.557a9.83 9.83 0 01-2.828.775 4.932 4.932 0 002.165-2.724 9.864 9.864 0 01-3.127 1.195 4.916 4.916 0 00-8.384 4.482C7.6