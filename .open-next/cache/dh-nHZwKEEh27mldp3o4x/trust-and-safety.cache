me\":\"w-6 h-6 rounded-full bg-[#059669]/10 text-[#059669] flex items-center justify-center font-bold text-sm shrink-0 mt-0.5\",\"children\":\"2\"}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Business Entity Checks:\"}],\" We verify corporate registration, tax status, and ultimate beneficial owners (UBOs).\"]}]]}],[\"$\",\"li\",null,{\"className\":\"flex items-start gap-3 text-[#064e3b]/80\",\"children\":[[\"$\",\"div\",null,{\"className\":\"w-6 h-6 rounded-full bg-[#059669]/10 text-[#059669] flex items-center justify-center font-bold text-sm shrink-0 mt-0.5\",\"children\":\"3\"}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Independent Financial Audit:\"}],\" Third-party CPAs review financial projections and current asset health.\"]}]]}],[\"$\",\"li\",null,{\"className\":\"flex items-start gap-3 text-[#064e3b]/80\",\"children\":[[\"$\",\"div\",null,{\"className\":\"w-6 h-6 rounded-full bg-[#059669]/10 text-[#059669] flex items-center justify-center font-bold text-sm shrink-0 mt-0.5\",\"children\":\"4\"}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Feasibility Analysis:\"}],\" Industry experts evaluate the technical and market feasibility of the proposed product.\"]}]]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"bg-white p-8 md:p-10 rounded-3xl shadow-lg border border-[#f2eadb]\",\"children\":[\"$L2\",\"$L3\",\"$L4\",\"$L5\",\"$L6\"]}],\"$L7\"]}],\"$L8\"]}]}]]}],null,\"$L9\"]}],\"isPartial\":false,\"staleTime\":300,\"varyParams\":null,\"buildId\":\"dh-nHZwKEEh27mldp3o4x\"}\n2:[\"$\",\"div\",null,{\"className\":\"w-16 h-16 bg-[#ecfdf5] rounded-2xl flex items-center justify-center text-3xl mb-6 shadow-inner\",\"children\":\"🔐\"}]\n3:[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-[#064e3b] mb-4\",\"children\":\"Fraud Prevention & Escrow\"}]\n4:[\"$\",\"p\",null,{\"className\":\"text-[#064e3b]/80 mb-6 leading-relaxed\",\"children\":\"Once a project is live, our tec