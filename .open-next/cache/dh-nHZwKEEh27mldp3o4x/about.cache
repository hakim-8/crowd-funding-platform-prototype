had-98.clerk.accounts.dev/npm/@clerk/ui@1/dist/ui.browser.js\" as=\"script\" crossorigin=\"anonymous\"/><title>Jade Fortune | Crowdfunding Platform</title><meta name=\"description\" content=\"Pioneering the future of crowdfunding. Empowering issuers and investors.\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.2vob68tjqpejf.ico\" sizes=\"256x256\" type=\"image/x-icon\"/><script src=\"https://cdn.tailwindcss.com\"></script><style type=\"text/tailwindcss\">\n              @layer utilities {\n                .glass {\n                  background: rgba(253, 251, 247, 0.7);\n                  backdrop-filter: blur(10px);\n                  -webkit-backdrop-filter: blur(10px);\n                  border: 1px solid rgba(255, 255, 255, 0.3);\n                }\n              }\n            </style><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-full flex flex-col selection:bg-[#059669] selection:text-[#fdfbf7] relative\"><div hidden=\"\"><!--$--><!--/$--></div><div class=\"fixed inset-0 bg-[#fdfbf7] -z-20\"></div><div class=\"fixed inset-0 bg-dot-pattern pointer-events-none -z-18\"></div><div class=\"fixed top-[-10%] right-[-10%] w-[50vw] h-[50vw] max-w-[600px] rounded-full bg-[#ecfdf5] opacity-80 blur-3xl pointer-events-none -z-15\"></div><div class=\"fixed bottom-[-10%] left-[-10%] w-[60vw] h-[60vw] max-w-[700px] rounded-full bg-[#059669]/5 blur-3xl pointer-events-none -z-15\"></div><canvas class=\"fixed inset-0 pointer-events-none -z-10\" style=\"opacity:0.8\"></canvas><style>\n        @media (min-width: 768px) {\n          .nav-desktop-only { display: flex !important; }\n          .nav-mobile-only { display: none !important; }\n          .nav-desktop-space-x > :not([hidden]) ~ :not([hidden]) {\n            --tw-space-x-reverse: 0;\n            margin-right: calc(2rem * var(--tw-space-x-reverse));\n            margin-left: calc(2rem * calc(1 - var(--tw-space-x-reverse)));\n          }\n        }\n        @media (max-width: 767px) {\n          .nav-desktop-only { display: none !important; }\n          .nav-mobile-only { display: flex !important; }\n        }\n      </style><nav class=\"sticky top-0 z-40 w-full glass shadow-sm\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"flex justify-between h-20 items-center\"><div class=\"flex-shrink-0 flex items-center\"><a class=\"text-2xl font-bold tracking-tighter text-[#064e3b] flex items-center gap-2\" href=\"/\"><svg class=\"w-8 h-8 filter drop-shadow-[0_2px_8px_rgba(16,185,129,0.35)] hover:rotate-12 transition-transform duration-300\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M9 9H15L17 2H7L9 9Z\" fill=\"#a7f3d0\"></path><path d=\"M7 2L9 9H2L7 2Z\" fill=\"#34d399\"></path><path d=\"M17 2L15 9H22L17 2Z\" fill=\"#059669\"></path><path d=\"M9 9H15L12 22L9 9Z\" fill=\"#10b981\"></path><path d=\"M2 9H9L12 22L2 9Z\" fill=\"#065f46\"></path><path d=\"M15 9H22L12 22L15 9Z\" fill=\"#047857\"></path></svg>Jade Fortune</a></div><div class=\"nav-mobile-only items-center\"><button class=\"text-[#064e3b] hover:text-[#059669] focus:outline-none focus:ring-2 focus:ring-inset focus:ring-[#059669] rounded-md p-2\"><span class=\"sr-only\">Open main menu</span><svg class=\"h-6 w-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6h16M4 12h16M4 18h16\"></path></svg></button></div><div class=\"nav-desktop-only nav-desktop-space-x items-center w-full justify-end hidden\"><a class=\"text-[#064e3b] font-medium transition-colors hover:opacity-80 whitespace-nowrap\" href=\"/\">Home</a><a style=\"color:#064e3b\" class=\"font-medium transition-colors hover:opacity-80 whitespace-nowrap\" href=\"/how-it-works\">How It Works</a><div class=\"relative\"><button style=\"color:#064e3b\" class=\"flex items-center font-medium transition-colors hover:opacity-80 gap-1 whitespace-nowrap\">More<svg class=\"w-4 h-4 transition-transform \" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"></path></svg></button></div><div class=\"relative\"><button style=\"color:#064e3b\" class=\"flex items-center font-medium transition-colors hover:opacity-80 gap-1 whitespace-nowrap\">Issuer<svg class=\"w-4 h-4 transition-transform \" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"></path></svg></button></div><div class=\"relative\"><button class=\"flex items-center font-medium transition-colors hover:opacity-80 gap-1 whitespace-nowrap\">Investors<svg class=\"w-4 h-4 transition-transform \" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"></path></svg></button></div></div></div></div></nav><main class=\"flex-grow relative z-10\"><div class=\"flex flex-col min-h-screen bg-[#fdfbf7] pb-24\"><section class=\"pt-32 pb-20 px-4 text-center relative overflow-hidden\"><div class=\"absolute inset-0 bg-gradient-to-b from-[#ecfdf5]/50 to-transparent\"></div><div class=\"relative z-10 max-w-4xl mx-auto\"><h1 class=\"text-5xl md:text-6xl font-extrabold text-[#064e3b] tracking-tight mb-6\">Building the Future of <br/> Trust in Crowdfunding</h1><p class=\"text-xl text-[#064e3b]/80 max-w-2xl mx-auto leading-relaxed\">We started Jade Fortune to bridge the gap between visionary ideas and the security that investors deserve.</p></div></section><section class=\"max-w-5xl mx-auto px-4 w-full mt-12 mb-24\"><div class=\"grid grid-cols-1 md:grid-cols-2 gap-12 items-center\"><div class=\"relative\"><div class=\"absolute inset-0 bg-[#059669]/10 transform translate-x-4 translate-y-4 rounded-3xl\"></div><img src=\"https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&amp;fit=crop&amp;w=800&amp;q=80\" alt=\"Team collaborating\" class=\"relative z-10 rounded-3xl shadow-lg border border-[#f2eadb]\"/></div><div><h2 class=\"text-3xl font-bold text-[#064e3b] mb-6\">Our Mission</h2><p class=\"text-[#064e3b]/80 text-lg leading-relaxed mb-8\">To democratize access to high-potential early-stage projects while establishing a gold standard of transparency, rigorous auditing, and accountability in the crowdfunding ecosystem.</p><h2 class=\"text-3xl font-bold text-[#064e3b] mb-6\">Our Vision</h2><p class=\"text-[#064e3b]/80 text-lg leading-relaxed\">A world where anyone can confidently fund the next breakthrough innovation, knowing their investment is protected by verifiable data and expert oversight.</p></div></div></section><section class=\"bg-[#064e3b] py-24 relative overflow-hidden\"><div class=\"absolute top-0 right-0 w-96 h-96 bg-[#059669] rounded-full filter blur-3xl opacity-30 transform translate-x-1/3 -translate-y-1/3\"></div><div class=\"absolute bottom-0 left-0 w-96 h-96 bg-[#059669] rounded-full filter blur-3xl opacity-30 transform -translate-x-1/3 translate-y-1/3\"></div><div class=\"max-w-7xl mx-auto px-4 w-full relative z-10\"><div class=\"text-center mb-16\"><h2 class=\"text-3xl md:text-4xl font-bold text-white mb-4\">Our Principles</h2><div class=\"w-24 h-1 bg-[#34d399] mx-auto rounded-full\"></div></div><div class=\"grid grid-cols-1 md:grid-cols-3 gap-8\"><div class=\"bg-white/10 backdrop-blur-md border border-white/20 p-8 rounded-3xl\"><div class=\"text-4xl mb-4\">🔍</div><h3 class=\"text-xl font-bold text-white mb-3\">Radical Transparency</h3><p class=\"text-white/80\">No hidden fees, no opaque algorithms. Every decision, audit, and milestone is documented and accessible.</p></div><div class=\"bg-white/10 backdrop-blur-md border border-white/20 p-8 rounded-3xl\"><div class=\"text-4xl mb-4\">🛡️</div><h3 class=\"text-xl font-bold text-white mb-3\">Uncompromising Security</h3><p class=\"text-white/80\">We prioritize the safety of our users&#x27; funds above all else, employing rigorous smart contracts and certified audits.</p></div><div class=\"bg-white/10 backdrop-blur-md border border-white/20 p-8 rounded-3xl\"><div class=\"text-4xl mb-4\">🤝</div><h3 class=\"text-xl font-bold text-white mb-3\">Mutual Growth</h3><p class=\"text-white/80\">We believe in symbiotic success. When creators succeed, backers succeed. Our platform is built to align incentives.</p></div></div></div></section><section class=\"max-w-4xl mx-auto px-4 w-full py-24\"><div class=\"text-center mb-16\"><h2 class=\"text-3xl md:text-4xl font-bold text-[#064e3b] mb-4\">Our Story</h2><div class=\"w-24 h-1 bg-[#059669] mx-auto rounded-full\"></div></div><div class=\"space-y-12 relative before:absolute before:inset-0 before:ml-5 before:-translate-x-px md:before:mx-auto md:before:translate-x-0 before:h-full before:w-0.5 before:bg-gradient-to-b before:from-transparent before:via-[#059669]/30 before:to-transparent\"><div class=\"relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group is-active\"><div class=\"flex items-center justify-center w-10 h-10 rounded-full border-4 border-white bg-[#059669] text-white shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2\"><span class=\"w-3 h-3 bg-white rounded-full\"></span></div><div class=\"w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] p-6 bg-white rounded-2xl shadow-sm border border-[#f2eadb]\"><div class=\"text-[#059669] font-bold mb-1\">2024</div><h3 class=\"font-bold text-[#064e3b] text-lg mb-2\">The Catalyst</h3><p class=\"text-[#064e3b]/70\">After witnessing billions lost to unverified projects in the digital space, our founders began architecting a trust-first platform.</p></div></div><div class=\"relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group is-active\"><div class=\"flex items-center justify-center w-10 h-10 rounded-full border-4 border-white bg-[#059669] text-white shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2\"><span class=\"w-3 h-3 bg-white rounded-full\"></span></div><div class=\"w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] p-6 bg-white rounded-2xl shadow-sm border border-[#f2eadb]\"><div class=\"text-[#059669] font-bold mb-1\">2025</div><h3 class=\"font-bold text-[#064e3b] text-lg mb-2\">Platform Beta</h3><p class=\"text-[#064e3b]/70\">Launched the first iteration of Jade Fortune to a closed group of 1,000 verified investors and 50 audited projects.</p></div></div><div class=\"relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group is-active\"><div class=\"flex items-center justify-center w-10 h-10 rounded-full border-4 border-white bg-[#059669] text-white shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2\"><span class=\"w-3 h-3 bg-white rounded-full\"></span></div><div class=\"w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] p-6 bg-[#059669] text-white rounded-2xl shadow-md border border-[#047857]\"><div class=\"text-[#a7f3d0] font-bold mb-1\">Today</div><h3 class=\"font-bold text-white text-lg mb-2\">Global Expansion</h3><p class=\"text-white/90\">Scaling the platform globally, introducing new auditing tiers, and redefining the standards of crowdfunding.</p></div></div></div></section><section class=\"bg-white py-24 border-t border-[#059669]/10\"><div class=\"max-w-7xl mx-auto px-4 w-full\"><div class=\"text-center mb-16\"><h2 class=\"text-3xl md:text-4xl font-bold text-[#064e3b] mb-4\">Meet the Leadership</h2><div class=\"w-24 h-1 bg-[#059669] mx-auto rounded-full\"></div></div><div class=\"grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-8\"><div class=\"text-center group\"><div class=\"relative w-32 h-32 md:w-48 md:h-48 mx-auto mb-4 md:mb-6 rounded-full overflow-hidden border-4 border-[#ecfdf5] group-hover:border-[#059669] transition-colors duration-300 bg-[#fdfbf7] flex items-center justify-center\"><svg class=\"w-1/2 h-1/2 text-[#059669]/30 group-hover:text-[#059669] transition-colors duration-300\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z\"></path></svg></div><h3 class=\"text-lg md:text-xl font-bold text-[#064e3b] mb-1\">Elena Rostova</h3><p class=\"text-sm md:text-base text-[#059669] font-medium\">Chief Executive Officer</p></div><div class=\"text-center group\"><div class=\"relative w-32 h-32 md:w-48 md:h-48 mx-auto mb-4 md:mb-6 rounded-full overflow-hidden border-4 border-[#ecfdf5] group-hover:border-[#059669] transition-colors duration-300 bg-[#fdfbf7] flex items-center justify-center\"><svg class=\"w-1/2 h-1/2 text-[#059669]/30 group-hover:text-[#059669] transition-colors duration-300\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z\"></path></svg></div><h3 class=\"text-lg md:text-xl font-bold text-[#064e3b] mb-1\">Marcus Chen</h3><p class=\"text-sm md:text-base text-[#059669] font-medium\">Chief Technical Officer</p></div><div class=\"text-center group\"><div class=\"relative w-32 h-32 md:w-48 md:h-48 mx-auto mb-4 md:mb-6 rounded-full overflow-hidden border-4 border-[#ecfdf5] group-hover:border-[#059669] transition-colors duration-300 bg-[#fdfbf7] flex items-center justify-center\"><svg class=\"w-1/2 h-1/2 text-[#059669]/30 group-hover:text-[#059669] transition-colors duration-300\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z\"></path></svg></div><h3 class=\"text-lg md:text-xl font-bold text-[#064e3b] mb-1\">Sarah Jenkins</h3><p class=\"text-sm md:text-base text-[#059669] font-medium\">Head of Auditing</p></div><div class=\"text-center group\"><div class=\"relative w-32 h-32 md:w-48 md:h-48 mx-auto mb-4 md:mb-6 rounded-full overflow-hid